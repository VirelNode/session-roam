#!/usr/bin/env bash
# stub claude: records invocation, never launches the real CLI

{ printf 'claude'; printf ' %s' "$@"; printf '\n'; } >> "${CLAUDE_STUB_LOG:-${STUB_LOG:-/dev/null}}"

case "${CLAUDE_STUB_MODE:-exit0}" in
    exit0)
        exit "${CLAUDE_STUB_EXIT:-0}"
        ;;
    sleep)
        /bin/sleep "${CLAUDE_STUB_SLEEP:-2}"
        exit 0
        ;;
    wait-signal)
        trap 'exit 0' TERM HUP
        # INT is acknowledged in the log so a test can prove the child really saw it.
        trap 'echo "stub-got-INT" >> "${CLAUDE_STUB_LOG:-/dev/null}"; exit 130' INT
        [[ -n ${CLAUDE_STUB_READY:-} ]] && : > "$CLAUDE_STUB_READY"
        local_max="${CLAUDE_STUB_MAX_WAIT:-30}"
        waited=0
        while (( waited < local_max )); do
            [[ -f ${CLAUDE_STUB_RELEASE:-/nonexistent} ]] && exit 0
            /bin/sleep 0.05
            waited=$((waited + 1))
        done
        # Natural timeout. Default 0 keeps older callers unchanged; signal tests set a distinct code.
        exit "${CLAUDE_STUB_TIMEOUT_RC:-0}"
        ;;
    *)
        exit 2
        ;;
esac
